+import random, sys, os
+import os
+exec(open(os.path.join(os.path.dirname(os.path.abspath(__file__)),'gen_regs.py')).read().split("vals=lambda")[0].replace("random.seed(int(sys.argv[2]) if len(sys.argv)>2 else 1)","random.seed(7)"))
+def randpre():
+    a=random.choice([0,1,0x80000000,0x7fffffff,random.getrandbits(32)]);b=random.choice([0,1,0xffffffff,0x80000000,random.getrandbits(32)])
+    return (a,b),cmpflags(a,b)
+nbytes={'b':1,'w':2,'l':4}
+def bytes_be(v,n): return [(v>>(8*(n-1-i)))&0xff for i in range(n)]
+cases=[]
+def flagsx(pre,upd): f=dict(pre); f.update(upd); return f
+modes=[('(a0)',0,'a0'),('(a0)+',1,'a0'),('-(a0)',-1,'a0'),('(a3)',0,'a3'),('(a3)+',1,'a3'),('-(a3)',-1,'a3'),('(a1)',0,'a1')]
+def mk(opfmt, size, v0, newv, fl, mode, extra_setup=None, d1=0):
+    cases.append((opfmt,size,v0,newv,fl,mode,d1))
+for mode in modes:
+    for s in 'bwl':
+        n=nbytes[s]
+        for v in [0,1,M[s],M[s]>>1,(M[s]>>1)+1,random.getrandbits(32)&M[s]]:
+            pc,pf=randpre()
+            r=(~v)&M[s]; mk(f'not.{s} {{m}}',s,v,r,(pc,flagsx(pf,dict(nz(r,s),V=0,C=0))),mode)
+            pc,pf=randpre()
+            r=(-v)&M[s]; mk(f'neg.{s} {{m}}',s,v,r,(pc,flagsx(pf,dict(nz(r,s),V=int(v==1<<(B[s]-1)),C=int(v!=0)))),mode)
+    for kind in ['asl','asr','lsl','lsr','rol','ror']:
+        for v in [0,1,0x8000,0x7fff,0xffff,0x4001,random.getrandbits(16)]:
+            pc,pf=randpre(); r,o,V=sh(kind,v,1,'w')
+            mk(f'{kind}.w {{m}}','w',v,r,(pc,flagsx(pf,dict(nz(r,'w'),V=V,C=o))),mode)
+    for k in ['btst','bset','bclr','bchg']:
+        for v in [0,0xff,0x81,random.getrandbits(8)]:
+            for nn in [0,1,7,8,9,15,255,random.randrange(256)]:
+                for form in 'ir':
+                    pc,pf=randpre(); bit=(v>>(nn%8))&1
+                    r=v if k=='btst' else (v|1<<(nn%8) if k=='bset' else v&~(1<<(nn%8)) if k=='bclr' else v^(1<<(nn%8)))
+                    fl=(pc,flagsx(pf,dict(Z=int(bit==0))))
+                    if form=='i': mk(f'{k}.b #{nn},{{m}}','b',v,r,fl,mode)
+                    else: mk(f'{k}.b d1,{{m}}','b',v,r,fl,mode,d1=(random.getrandbits(32)&~0xff)|nn)
+
+def emit(chunk):
+    L=['start:']
+    for i,(op,s,v0,nv,(pc,fl),(mtxt,delta,reg),d1) in enumerate(chunk,1):
+        sh=op.split()[0].split('.')[0] in ('asl','asr','lsl','lsr','rol','ror')
+        bit=op[0]=='b' and op.split('.')[0] in ('btst','bset','bclr','bchg')
+        n=2 if sh else 1 if bit else nbytes[s]
+        sz='w' if sh else 'b' if bit else s
+        L+=['        lea buf, a2','        addq.l #8, a2','        move.l #$A5A5A5A5, d3',
+            '        subq.l #4, a2','        move.l d3, (a2)','        addq.l #8, a2','        move.l d3, (a2)','        subq.l #4, a2',
+            f'        move.{sz} #${v0:x}, (a2)']
+        L.append(f'        lea buf, {reg}'); L.append(f'        addq.l #8, {reg}')
+        if delta==-1: L.append(f'        addq.l #{n}, {reg}')
+        L+=[f'        move.l #${d1:08x}, d1',f'        move.l #${pc[0]:08x}, d5',f'        cmp.l #${pc[1]:08x}, d5',
+            '        '+op.format(m=mtxt)]
+        for r in (4,5,6,7): L.append(f'        move.l #0, a{r}')
+        for r,(br,fn) in zip((4,5,6,7),[('bcc','C'),('bvc','V'),('bne','Z'),('bpl','N')]):
+            L+= [f'        {br}.w g{i}_{r}',f'        move.l #1, a{r}',f'g{i}_{r}:']
+        for r,fn in zip((4,5,6,7),'CVZN'):
+            L+=[f'        cmpa.l #{fl[fn]}, a{r}',f'        bne.w f{i}']
+        L+=['        move.l #0, d3','        lea buf, a2','        addq.l #8, a2',f'        move.{sz} (a2), d3',f'        cmp.l #${nv:x}, d3',f'        bne.w f{i}']
+        L+=['        subq.l #4, a2','        move.l (a2), d3','        cmp.l #$A5A5A5A5, d3',f'        bne.w f{i}',
+            '        addq.l #8, a2','        addq.l #4, a2','        subq.l #4, a2' if False else '        nop']
+        # upper canary at buf+12
+        L+=['        lea buf, a2','        addq.l #8, a2','        addq.l #4, a2','        move.l (a2), d3','        cmp.l #$A5A5A5A5, d3',f'        bne.w f{i}']
+        L+=['        lea buf, a2','        addq.l #8, a2',f'        move.l {reg}, d3','        move.l a2, d2','        sub.l d2, d3',
+            f'        cmp.l #{delta*n if delta==1 else 0}, d3',f'        bne.w f{i}']
+    L+=['        moveq #0, d0','        rts']
+    for i in range(1,len(chunk)+1): L+=[f'f{i}:     moveq #{i}, d0','        rts']
+    L+=['buf:    dc.l 0, 0, 0, 0, 0']
+    return '\n'.join(L)+'\n'
+out=sys.argv[1]; os.makedirs(out,exist_ok=True)
+CH=60
+for k in range(0,len(cases),CH):
+    open(f'{out}/m{k//CH:03d}.asm','w').write(emit(cases[k:k+CH]))
+    open(f'{out}/m{k//CH:03d}.txt','w').write('\n'.join(c[0].format(m=c[5][0]) for c in cases[k:k+CH]))
+print(len(cases),'cases')
