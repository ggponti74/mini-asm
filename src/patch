diff --git a/tests/diff/groups_cmpm.py b/tests/diff/groups_cmpm.py
new file mode 100644
index 0000000..365a263
--- /dev/null
+++ b/tests/diff/groups_cmpm.py
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+"""CMPM (Ay)+,(Ax)+ against a real 68K (see diff.py): the flags of Ax - Ay for every size and many
+values, with the two pointers in different registers (a0 is a real register on x86, the others are
+spilled), the same register for both operands, and a check that both pointers advance by the size."""
+import os, sys
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import diff
+
+diff.ARENA = True  # `arena` and `cellmid` are the two 256-byte halves of the data area
+
+FULL = diff.VALUES
+FEW = [0, 0x7F, 0x80, 0xFFFFFFFF, 0x12345678]
+PAIRS = [("a0", "a3", FULL), ("a3", "a0", FULL), ("a3", "a4", FEW), ("a4", "a3", FEW)]
+
+def distinct(ay, ax, sv, dv):
+    # the source long lives at cellmid, the destination long at arena
+    return ["lea     cellmid, a5", "move.l  #$%x, (a5)" % sv, "lea     arena, a5", "move.l  #$%x, (a5)" % dv,
+            "lea     cellmid, %s" % ay, "lea     arena, %s" % ax, "moveq   #0, d1"]
+
+def same(a, sv, dv):
+    # one register for both: the source is at arena, the destination right behind it
+    return ["lea     arena, a5", "move.l  #$%x, (a5)" % sv, "move.l  #$%x, 4(a5)" % dv,
+            "lea     arena, %s" % a, "moveq   #0, d1"]
+
+groups = []
+for sz in "bwl":
+    for ay, ax, vals in PAIRS:
+        groups.append(("cmpm.%s.%s.%s" % (sz, ay, ax),
+                       [(distinct(ay, ax, sv, dv), ["cmpm.%s  (%s)+, (%s)+" % (sz, ay, ax)]) for sv in vals for dv in vals]))
+    for a in ("a0", "a3"):
+        groups.append(("cmpm.%s.same.%s" % (sz, a),
+                       [(same(a, sv, dv), ["cmpm.%s  (%s)+, (%s)+" % (sz, a, a)]) for sv in FEW for dv in FEW]))
+    # both pointers must have moved by the size (a delta from each start; the flags don't matter here)
+    for ay, ax, vals in PAIRS[:3]:
+        tail = ["lea     cellmid, a5", "move.l  %s, d2" % ay, "move.l  a5, d5", "sub.l   d5, d2",
+                "lea     arena, a5", "move.l  %s, d1" % ax, "move.l  a5, d5", "sub.l   d5, d1",
+                "asl.l   #8, d2", "add.l   d2, d1"]
+        groups.append(("cmpm.%s.%s.%s.ptr" % (sz, ay, ax),
+                       [(distinct(ay, ax, 0x01020304, 0x05060708), ["cmpm.%s  (%s)+, (%s)+" % (sz, ay, ax)] + tail)]))
+    for a in ("a0", "a3"):
+        tail = ["lea     arena, a5", "move.l  %s, d1" % a, "move.l  a5, d5", "sub.l   d5, d1"]
+        groups.append(("cmpm.%s.same.%s.ptr" % (sz, a),
+                       [(same(a, 0x01020304, 0x05060708), ["cmpm.%s  (%s)+, (%s)+" % (sz, a, a)] + tail)]))
+
+if __name__ == "__main__":
+    ok = tot = 0
+    for name, cases in groups:
+        a, b = diff.check(name, cases)
+        ok += a; tot += b
+    print("---- %d of %d (group, target) runs match real 68K" % (ok, tot))
+    sys.exit(0 if ok == tot else 1)
