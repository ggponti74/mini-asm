--- /dev/null
+++ b/tests/trap/hello_exit.asm
@@ -0,0 +1,16 @@
+; EXIT: 7
+; STDOUT: hi
+; write "hi" + newline to stdout, then leave through the exit service (status = D1)
+start:  move.l  #2, d0              ; write
+        move.l  #1, d1              ; fd 1
+        lea     text, a0
+        move.l  #3, d2
+        trap    #0
+        cmp.l   #3, d0              ; all 3 bytes written
+        bne     bad
+        move.l  #1, d0              ; exit
+        move.l  #7, d1
+        trap    #0
+bad:    move.l  #100, d0
+        rts
+text    dc.b    "hi", 10
