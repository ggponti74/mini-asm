diff --git a/tests/diff/groups_muldiv.py b/tests/diff/groups_muldiv.py
new file mode 100644
index 0000000..a2b0839
--- /dev/null
+++ b/tests/diff/groups_muldiv.py
@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""MULU / MULS / DIVU / DIVS against a real 68K (see diff.py): register, immediate and memory
+sources, the flags, DIV overflow (V set, the destination left alone), and a check that
+(An)+ / -(An) move the pointer by 2. Division by zero is not here: it raises an exception on
+a 68K and SIGFPE in mini-asm's executables. When DIV overflows the 68000 leaves N and Z
+undefined, so the capture routine capd records only V in that case."""
+import os, sys
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import diff
+
+diff.ARENA = True
+diff.CAP += """
+capd    bvs     capd_v
+        bpl     capd_n
+        addq.l  #1, a2
+capd_n  bne     capd_z
+        addq.l  #2, a2
+capd_z  bcc     capd_s
+        addq.l  #8, a2
+capd_s  bra     capd_st
+capd_v  addq.l  #4, a2
+capd_st move.l  d1, (a1)+
+        move.l  a2, d3
+        move.l  d3, (a1)+
+        move.l  #0, a2
+        rts
+"""
+
+DEST = [0, 1, 0x7FFF, 0x8000, 0xFFFF, 0x10000, 0x7FFFFFFF, 0x80000000, 0xFFFFFFFF, 0x12345678, 0xFFFF0000, 0x00010001]
+SRC = [1, 2, 3, 0x7F, 0x80, 0x7FFF, 0x8000, 0xFFFF, 0x1234, 0xFFFE, 0xABCD0003, 0x1234FFFF]
+MULSRC = SRC + [0, 0xFFFF0000]
+FEW_D = [0, 1, 0x8000, 0xFFFF, 0x80000000, 0x12345678, 0xFFFF0000]
+FEW_S = [1, 3, 0x7FFF, 0x8000, 0xFFFF, 0xABCD0003]
+MODES = [("ind", "(%s)", 0), ("post", "(%s)+", 0), ("pre", "-(%s)", 2), ("disp", "-2(%s)", 2)]
+
+def skip(mn, dv, sv):
+    # DIVS of $80000000 by -1 overflows; qemu-m68k executes it as a host idiv and dies with SIGFPE,
+    # so that one case has its own group below (checked against the manual instead)
+    return mn == "divs" and dv == 0x80000000 and (sv & 0xFFFF) == 0xFFFF
+
+def only(name):
+    pat = os.environ.get("ONLY")
+    return not pat or pat in name
+
+def mem_setup(base, off, sv):
+    # a word with the source value at `cell`; the base register is parked `off` bytes past it
+    return ["lea     cell, a5", "move.l  #$%x0000, (a5)" % (sv & 0xFFFF), "lea     cell, %s" % base] + (["addq.l  #2, %s" % base] if off else [])
+
+groups = []
+for mn in ("mulu", "muls", "divu", "divs"):
+    cap = "capd" if mn.startswith("div") else "cap"
+    srcs = MULSRC if mn.startswith("mul") else SRC
+    groups.append(("%s.dn" % mn, [(["move.l  #$%x, d1" % dv, "move.l  #$%x, d2" % sv], ["%s  d2, d1" % mn], cap) for dv in DEST for sv in srcs if not skip(mn, dv, sv)]))
+    groups.append(("%s.imm" % mn, [(["move.l  #$%x, d1" % dv], ["%s  #$%x, d1" % (mn, sv & 0xFFFF)], cap) for dv in DEST for sv in srcs if not skip(mn, dv, sv)]))
+    groups.append(("%s.same" % mn, [(["move.l  #$%x, d1" % dv], ["%s  d1, d1" % mn], cap) for dv in DEST if (mn.startswith("mul") or (dv & 0xFFFF))]))
+    groups.append(("%s.d3d4" % mn, [(["move.l  #$%x, d3" % dv, "move.l  #$%x, d7" % sv], ["%s  d7, d3" % mn, "move.l  d3, d1"], cap) for dv in FEW_D for sv in FEW_S if not skip(mn, dv, sv)]))
+    for base in ("a0", "a3"):
+        for mname, tmpl, off in MODES:
+            groups.append(("%s.%s.%s" % (mn, base, mname),
+                           [(mem_setup(base, off, sv) + ["move.l  #$%x, d1" % dv], ["%s  %s, d1" % (mn, tmpl % base)], cap) for dv in FEW_D for sv in FEW_S + [0xFFFF0003] if not skip(mn, dv, sv)]))
+        for mname, tmpl, off in MODES[1:3]:
+            tail = ["lea     cell, a5", "move.l  %s, d2" % base, "move.l  a5, d5", "sub.l   d5, d2", "move.l  d2, d1"]
+            groups.append(("%s.%s.%s.ptr" % (mn, base, mname), [(mem_setup(base, off, 3) + ["move.l  #$10, d1"], ["%s  %s, d1" % (mn, tmpl % base)] + tail)]))
+
+def intmin_check():
+    """DIVS $80000000 / -1: the quotient (+2^31) doesn't fit, so V is set and D1 stays as it was."""
+    import struct
+    expect = struct.pack(">II", 0x80000000, 4)  # d1 unchanged; capd records V alone on an overflow
+    ok = 0
+    for form in ("d2, d1", "#$ffff, d1"):
+        cases = [(["move.l  #$80000000, d1", "move.l  #$FFFF, d2"], ["divs  " + form], "capd")]
+        for t in diff.TARGETS:
+            got, info = diff.run_target(diff.build(cases, "mini", True), "divs_intmin", t)
+            good = got == expect
+            print("divs %-12s INT_MIN / -1 per the manual  %-4s %s" % (form, t, "ok" if good else "DIFFERS (%r)" % (got,)))
+            ok += good
+    return ok, 2 * len(diff.TARGETS)
+
+if __name__ == "__main__":
+    ok = tot = 0
+    if only("intmin"):
+        a, b = intmin_check(); ok += a; tot += b
+    for name, cases in groups:
+        if not only(name):
+            continue
+        a, b = diff.check(name, cases)
+        ok += a; tot += b
+    print("---- %d of %d (group, target) runs match real 68K" % (ok, tot))
+    sys.exit(0 if ok == tot else 1)
