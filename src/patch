@@ -0,0 +1,86 @@
+# gen_regs.py <outdir> [seed] - generates self-checking bit-manipulation programs (t*.asm).
+# The expected results come from a small independent model of the 68K rules
+# (see sh/kind simulation below), not from mini-asm. Each program exits 0 when
+# every case matched, or with the number of the first failing case.
+# gen_mem.py does the same for memory operands (m*.asm).
+import random, sys, os
+random.seed(int(sys.argv[2]) if len(sys.argv)>2 else 1)
+M={'b':0xff,'w':0xffff,'l':0xffffffff}
+B={'b':8,'w':16,'l':32}
+def msb(v,s): return (v>>(B[s]-1))&1
+def cmpflags(a,b):
+    d=(a-b)&0xffffffff
+    return dict(N=d>>31,Z=int(d==0),V=(((a^b)&(a^d))>>31)&1,C=int(a<b))
+def sh(kind,v,c,s):
+    b=B[s];m=M[s];out=0;V=0
+    for _ in range(c):
+        old=msb(v,s)
+        if kind in('asl','lsl'): out=old;v=(v<<1)&m; V|=int(kind=='asl' and msb(v,s)!=old)
+        elif kind=='lsr': out=v&1;v>>=1
+        elif kind=='asr': out=v&1;v=(v>>1)|(old<<(b-1))
+        elif kind=='rol': out=old;v=((v<<1)|out)&m
+        elif kind=='ror': out=v&1;v=(v>>1)|(out<<(b-1))
+    return v,out,V
+def res(d0,r,s): return (d0&~M[s]&0xffffffff)|r
+def nz(r,s): return dict(N=msb(r,s),Z=int(r==0))
+vals=lambda s:[0,1,M[s],M[s]>>1,(M[s]>>1)+1,0x55&M[s],random.getrandbits(32)&M[s],random.getrandbits(32)&M[s]]
+cases=[]  # (setup lines, op line, expected d0, flags expected dict(N,Z,V,C))
+def case(op,d0,d1,pre,newd0,fl,extra=None):
+    cases.append((d0,d1,pre,op,newd0,fl))
+def flags_after(pre,upd): 
+    f=dict(pre); f.update(upd); return f
+def randpre():
+    a=random.choice([0,1,0x80000000,0x7fffffff,random.getrandbits(32)]);b=random.choice([0,1,0xffffffff,0x80000000,random.getrandbits(32)])
+    return (a,b),cmpflags(a,b)
+for s in 'bwl':
+    D0=lambda:random.getrandbits(32)
+    for v in vals(s):
+        d0=(D0()&~M[s])|v
+        pc,pf=randpre()
+        r=(~v)&M[s]; case(f'not.{s} d0',d0,0,(pc,pf),res(d0,r,s),flags_after(pf,dict(nz(r,s),V=0,C=0)))
+        pc,pf=randpre()
+        r=(-v)&M[s]; case(f'neg.{s} d0',d0,0,(pc,pf),res(d0,r,s),flags_after(pf,dict(nz(r,s),V=int(v==1<<(B[s]-1)),C=int(v!=0))))
+        for kind in ['asl','asr','lsl','lsr','rol','ror']:
+            for c in range(1,9):
+                pc,pf=randpre();r,o,V=sh(kind,v,c,s)
+                case(f'{kind}.{s} #{c},d0',d0,0,(pc,pf),res(d0,r,s),flags_after(pf,dict(nz(r,s),V=V,C=o)))
+            for c in [0,1,2,7,8,9,15,16,17,31,32,33,63,64,65,0x105,random.randrange(256)]:
+                pc,pf=randpre();r,o,V=sh(kind,v,c&63,s)
+                cnt=(random.getrandbits(32)&~0xff)|c if random.random()<.5 else c
+                case(f'{kind}.{s} d1,d0',d0,cnt,(pc,pf),res(d0,r,s),flags_after(pf,dict(nz(r,s),V=V,C=o)))
+for v in [0,1,0x80,0xff,0x7fff,0x8000,0xffff,0x12345678,0x80000000,0xdeadbeef]:
+    pc,pf=randpre(); r=((v<<16)|(v>>16))&0xffffffff
+    case('swap d0',v,0,(pc,pf),r,flags_after(pf,dict(nz(r,'l'),V=0,C=0)))
+    d0=v
+    pc,pf=randpre(); lo=v&0xff; r8=lo|(0xff00 if lo&0x80 else 0); r=(d0&0xffff0000)|r8
+    case('ext.w d0',d0,0,(pc,pf),r,flags_after(pf,dict(nz(r8,'w'),V=0,C=0)))
+    pc,pf=randpre(); lo=v&0xffff; r=lo|(0xffff0000 if lo&0x8000 else 0)
+    case('ext.l d0',d0,0,(pc,pf),r,flags_after(pf,dict(nz(r,'l'),V=0,C=0)))
+for k in ['btst','bset','bclr','bchg']:
+    for v in [0,0xffffffff,0x80000001,random.getrandbits(32),random.getrandbits(32)]:
+        for n in [0,1,7,8,15,31,32,33,63,255,random.randrange(256)]:
+            for form in 'ir':
+                pc,pf=randpre(); bit=(v>>(n%32))&1
+                r=v if k=='btst' else (v|1<<(n%32) if k=='bset' else v&~(1<<(n%32)) if k=='bclr' else v^(1<<(n%32)))
+                fl=flags_after(pf,dict(Z=int(bit==0)))
+                if form=='i': case(f'{k}.l #{n},d0',v,0,(pc,pf),r,fl)
+                else: case(f'{k}.l d1,d0',v,(random.getrandbits(32)&~0xff)|n if n<256 else n,(pc,pf),r,fl)
+def emit(chunk,idx,arch):
+    L=['start:']
+    for i,(d0,d1,(pc,pf),op,nd0,fl) in enumerate(chunk,1):
+        L+= [f'        move.l #${d0:08x}, d0',f'        move.l #${d1:08x}, d1',f'        move.l #${pc[0]:08x}, d5',f'        cmp.l #${pc[1]:08x}, d5',f'        {op}']
+        for r in (1,2,3,4): L.append(f'        move.l #0, a{r}')
+        for r,(br,fn) in enumerate([('bcc','C'),('bvc','V'),('bne','Z'),('bpl','N')],1):
+            L+= [f'        {br}.w g{i}_{r}',f'        move.l #1, a{r}',f'g{i}_{r}:']
+        L+=[f'        cmp.l #${nd0:08x}, d0',f'        bne.w f{i}']
+        for r,fn in enumerate('CVZN',1):
+            L+=[f'        cmpa.l #{fl[fn]}, a{r}',f'        bne.w f{i}']
+    L+=['        moveq #0, d0','        rts']
+    for i in range(1,len(chunk)+1): L+=[f'f{i}:     moveq #{i}, d0','        rts']
+    return '\n'.join(L)+'\n'
+out=sys.argv[1];os.makedirs(out,exist_ok=True)
+CH=100
+for n in range(0,len(cases),CH):
+    open(f'{out}/t{n//CH:03d}.asm','w').write(emit(cases[n:n+CH],n//CH,'x'))
+    open(f'{out}/t{n//CH:03d}.txt','w').write('\n'.join(c[3] for c in cases[n:n+CH]))
+print(len(cases),'cases')
