+        moveq   #23, d3
+        move.l  #2, d0              ; service 2 = write
+        move.l  #1, d1              ; fd 1
+        lea     buf, a0
+        moveq   #0, d2              ; length 0: nothing is printed
+        trap    #0
+        bne     fail                ; N/Z come from D0
+        bmi     fail
+        ; ---- 24: TRAP #0 preserves everything except D0 ------------
+        moveq   #24, d3
+        move.l  #99, d1             ; bad fd, so nothing is written either
+        move.l  #5, d2
+        move.l  #$AAAA5555, d5
+        move.l  #$12345678, d7
+        lea     buf, a0
+        lea     buf2, a1
+        move.l  #2, d0
+        trap    #0
+        cmp.l   #99, d1
+        bne     fail
+        cmp.l   #5, d2
+        bne     fail
+        cmp.l   #24, d3
+        bne     fail
+        cmp.l   #$AAAA5555, d5
+        bne     fail
+        cmp.l   #$12345678, d7
+        bne     fail
+        lea     buf, a2
+        cmpa.l  a2, a0
+        bne     fail
+        lea     buf2, a2
+        cmpa.l  a2, a1
+        bne     fail
+        ; ---- 25: errors come back negative: write to a bad fd -> -9 ---
+        moveq   #25, d3
+        move.l  #2, d0
+        move.l  #99, d1             ; no such fd
+        lea     buf, a0
+        moveq   #1, d2
+        trap    #0
+        bpl     fail                ; negative: N is set
+        cmp.l   #-9, d0             ; -EBADF
+        bne     fail
+        ; ---- 26: read from a bad fd -> -9 ---------------------------
+        moveq   #26, d3
+        move.l  #3, d0              ; service 3 = read
+        move.l  #99, d1
+        lea     buf, a0
+        moveq   #1, d2
+        trap    #0
+        cmp.l   #-9, d0
+        bne     fail
+        ; ---- 27: unknown service -> -38 (-ENOSYS) --------------------
+        moveq   #27, d3
+        move.l  #99, d0
+        trap    #0
+        bpl     fail
+        cmp.l   #-38, d0
+        bne     fail
