+            return fail(ERR_BYTE_REG);
+        if (size == SIZE_W)
+            buffer_write(out, X86_OPSIZE_PREFIX);
+        buffer_write(out, size == SIZE_B ? 0x80 : 0x81);
+        buffer_write(out, (uint8_t)(0xC0 | (ext << 3) | d));
+        write_le(out, (uint32_t)imm, bytes);
