 #    their first line ("; EXPECT: <extended regex>").
 # 3. tests/arm/*.asm: ARM programs, run with qemu-arm when available (exit code must match "; EXIT: n").
 # 4. tests/main.asm must also assemble for the x86 (PE) target (assembly only).
+# 5. tests/trap/*.asm: TRAP #0 programs, run natively. Header lines: "; EXIT: n", optional
+#    "; STDIN: text" (fed to the program) and "; STDOUT: text" (must match its output).
+#    They must not assemble for the x86 (PE) and arm targets, which have no dispatcher yet.
 
 ASM=${1:-./mini-asm}
 DIR=$(cd "$(dirname "$0")" && pwd)
@@ -98,6 +101,36 @@ else
     echo "FAIL   main (x86/PE does not assemble)"; fail=$((fail + 1))
 fi
 
+# 5. TRAP #0 programs (tests/trap/*.asm)
+for src in "$DIR"/trap/*.asm; do
+    name=trap/$(basename "$src" .asm)
+    want=$(sed -n 's/^; EXIT: //p' "$src")
+    input=$(sed -n 's/^; STDIN: //p' "$src")
+    if ! "$ASM" -t elf -o "$TMP/trap.bin" "$src" >"$TMP/asm.log" 2>&1; then
+        echo "FAIL   $name   (did not assemble)"; fail=$((fail + 1)); continue
+    fi
+    printf '%s' "$input" | "$TMP/trap.bin" >"$TMP/trap.out"; got=$?
+    if [ "$got" -ne "$want" ]; then
+        echo "FAIL   $name   (exit $got, expected $want)"; fail=$((fail + 1)); continue
+    fi
+    if grep -q '^; STDOUT: ' "$src"; then
+        wantout=$(sed -n 's/^; STDOUT: //p' "$src")
+        if [ "$(cat "$TMP/trap.out")" != "$wantout" ]; then
+            echo "FAIL   $name   (stdout was '$(cat "$TMP/trap.out")', expected '$wantout')"; fail=$((fail + 1)); continue
+        fi
+    fi
+    echo "PASS   $name"; pass=$((pass + 1))
+done
+for tgt in x86 arm; do
+    if "$ASM" -t $tgt -o "$TMP/trap.bin" "$DIR/trap/hello_exit.asm" >/dev/null 2>"$TMP/err.log"; then
+        echo "FAIL   trap/$tgt   (assembled, but TRAP is not supported there yet)"; fail=$((fail + 1))
+    elif grep -q 'TRAP is not supported on this target' "$TMP/err.log"; then
+        echo "PASS   trap/$tgt (clear 'not supported' error)"; pass=$((pass + 1))
+    else
+        echo "FAIL   trap/$tgt   (unexpected message)"; sed 's/^/         got: /' "$TMP/err.log"; fail=$((fail + 1))
+    fi
+done
+
 echo "----"
 echo "$pass ok, $fail failed"
 [ "$fail" -eq 0 ]
