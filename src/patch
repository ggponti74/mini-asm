diff --git a/tests/args/args_many.asm b/tests/args/args_many.asm
new file mode 100644
index 0000000..bce69d8
--- /dev/null
+++ b/tests/args/args_many.asm
@@ -0,0 +1,19 @@
+; EXIT: 0
+; ARGS: a bb ccc dddd eeeee
+; argc = 6 (the command + 5 arguments): argv[0..5] are non-NULL pointers and
+; argv[6] is the NULL terminator. dbra with d1 = 5 runs the loop 6 times.
+start:
+        cmp.l   #6, d0
+        bne     bad
+        moveq   #5, d1
+walk:   move.l  (a0)+, a1
+        cmp.l   #0, a1
+        beq     bad
+        dbra    d1, walk
+        move.l  (a0), d2
+        cmp.l   #0, d2
+        bne     bad
+        moveq   #0, d0
+        rts
+bad:    moveq   #1, d0
+        rts
