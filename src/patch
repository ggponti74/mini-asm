new file mode 100644
index 0000000..955c288
--- /dev/null
+++ b/tests/diff/groups_adda.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""ADDA / SUBA against a real 68K (see diff.py): register, address-register, immediate and memory
+sources, .w and .l, and a check that the flags are left alone. The capture routines capa/capa0 read
+a6/a0 AFTER the flags were recorded, so the flags shown are the ones ADDA/SUBA left behind."""
+import os, sys
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import diff
+
+diff.CAP += """
+capa    bpl     capa_n
+        addq.l  #1, a2
+capa_n  bne     capa_z
+        addq.l  #2, a2
+capa_z  bvc     capa_v
+        addq.l  #4, a2
+capa_v  bcc     capa_c
+        addq.l  #8, a2
+capa_c  move.l  a6, d1
+        move.l  d1, (a1)+
+        move.l  a2, d3
+        move.l  d3, (a1)+
+        move.l  #0, a2
+        rts
+"""
+
+DEST = [0, 1, 0x7FFFFFFF, 0xFFFFFFFF, 0x12345678]
+SRC = [0, 1, 0x7FFF, 0x8000, 0xFFFF, 0x7FFFFFFF, 0x80000000, 0xFFFFFFFF, 0x12345678]
+IMMS = {"w": [0, 1, 0x7FFF, 0x8000, 0xFFFF], "l": [0, 1, 0xFFFF, 0x7FFFFFFF, 0xFFFFFFFF, 0x12345678]}
+FLAGS = ["moveq   #-1, d5", "moveq   #0, d5"]  # N set, or Z set: ADDA/SUBA must keep whichever it is
+MODES = [("ind", "(%s)", 0), ("post", "(%s)+", 0), ("pre", "-(%s)", 4), ("disp", "-4(%s)", 4)]
+
+def pre(base, off, mv):
+    return ["lea     cell, a5", "move.l  #$%x, (a5)" % mv, "lea     cell, %s" % base] + (["addq.l  #4, %s" % base] if off else [])
+
+groups = []
+for mn in ("adda", "suba"):
+    for sz in "wl":
+        # Dn and An sources
+        groups.append(("%s.%s.dn" % (mn, sz), [(["move.l  #$%x, a6" % dv, "move.l  #$%x, d2" % sv, FLAGS[f]], ["%s.%s  d2, a6" % (mn, sz)], "capa") for dv in DEST for sv in SRC for f in (0, 1)]))
+        groups.append(("%s.%s.an" % (mn, sz), [(["move.l  #$%x, a6" % dv, "move.l  #$%x, a4" % sv, FLAGS[f]], ["%s.%s  a4, a6" % (mn, sz)], "capa") for dv in DEST for sv in SRC for f in (0, 1)]))
+        groups.append(("%s.%s.same" % (mn, sz), [(["move.l  #$%x, a6" % dv, FLAGS[f]], ["%s.%s  a6, a6" % (mn, sz)], "capa") for dv in DEST for f in (0, 1)]))
+        groups.append(("%s.%s.imm" % (mn, sz), [(["move.l  #$%x, a6" % dv, FLAGS[f]], ["%s.%s  #$%x, a6" % (mn, sz, i)], "capa") for dv in DEST for i in IMMS[sz] for f in (0, 1)]))
+        # memory sources: (An), (An)+, -(An), d(An) with a0 (real on x86) and a3 (spilled)
+        for base in ("a0", "a3"):
+            for mname, tmpl, off in MODES:
+                groups.append(("%s.%s.%s.%s" % (mn, sz, base, mname),
+                               [(pre(base, off, mv) + ["move.l  #$%x, a6" % dv, FLAGS[f]], ["%s.%s  %s, a6" % (mn, sz, tmpl % base)], "capa")
+                                for mv in SRC for dv in DEST for f in (0, 1)]))
+            # the pointer moves by the size for (An)+ / -(An)
+            for mname, tmpl, off in MODES[1:3]:
+                tail = ["lea     cell, a5", "move.l  %s, d2" % base, "move.l  a5, d5", "sub.l   d5, d2", "move.l  d2, d1"]
+                groups.append(("%s.%s.%s.%s.ptr" % (mn, sz, base, mname), [(pre(base, off, 0x01020304) + ["move.l  #$10, a6"], ["%s.%s  %s, a6" % (mn, sz, tmpl % base)] + tail)]))
+        # the destination is also the pointer: a0 = a0 +/- (a0) with the side effect of the mode, as a delta from `cell`
+        for mname, tmpl, off in MODES:
+            tail = ["lea     cell, a5", "move.l  a0, d2", "move.l  a5, d5", "sub.l   d5, d2", "move.l  d2, d1"]
+            groups.append(("%s.%s.alias.%s" % (mn, sz, mname),
+                           [(pre("a0", off, mv), ["%s.%s  %s, a0" % (mn, sz, tmpl % "a0")] + tail) for mv in SRC]))
+
+if __name__ == "__main__":
+    ok = tot = 0
+    for name, cases in groups:
+        a, b = diff.check(name.replace(" ", "").replace("(", "_").replace(")", "").replace(",", "_"), cases)
+        ok += a; tot += b
+    print("---- %d of %d (group, target) runs match real 68K" % (ok, tot))
+    sys.exit(0 if ok == tot else 1)
