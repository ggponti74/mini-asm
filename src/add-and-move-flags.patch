@@ -58,6 +58,17 @@ static bool emit_x86_move_imm32(const Operand *operands, OutputBuffer *out) {
     buffer_write(out, (uint8_t)((v >> 8) & 0xFF));
     buffer_write(out, (uint8_t)((v >> 16) & 0xFF));
     buffer_write(out, (uint8_t)((v >> 24) & 0xFF));
+
+    // 68K MOVE to a data register sets N and Z from the value moved and
+    // clears V and C (X is untouched). x86 "mov" doesn't touch any flags,
+    // so follow it with "test r,r" (85 /r, ModRM = 11 rrr rrr): that sets
+    // SF/ZF from the value and clears CF/OF -- exactly the 68K result, and
+    // it doesn't modify the register. MOVE to an address register is really
+    // MOVEA on the 68K, which affects no flags, so no test there.
+    if (reg->value.reg <= 7) {
+        buffer_write(out, 0x85);
+        buffer_write(out, (uint8_t)(0xC0 | (r << 3) | r));
+    }
     return true;
 }
 
@@ -84,6 +95,41 @@ static bool emit_x86_lea(const Operand *operands, OutputBuffer *out) {
     return true;
 }
 
+// x86 ADD, with 68K operand order (add src, dst  ->  dst += src):
+//   add #imm, Dn : 81 /0 id  -> opcode 81, ModRM = 11 000 rrr, imm32
+//   add Ds,  Dn  : 01 /r     -> opcode 01, ModRM = 11 sss ddd
+// (01 /r is "ADD r/m32, r32": reg field = source, r/m field = destination.)
+// The real x86 ADD already updates ZF/SF/CF/OF the way the 68K ADD updates
+// Z/N/C/V, so no extra code is needed for the condition codes.
+static bool emit_x86_add(const Operand *operands, OutputBuffer *out) {
+    const Operand *src = &operands[0], *dst = &operands[1];
+    if (dst->type != OPERAND_REGISTER) return false;
+    // Like the real 68K, ADD targets a data register (A-register targets
+    // would be ADDA, a different instruction).
+    if (dst->value.reg > 7) return false;
+    int d = x86_reg_code(dst->value.reg);
+    if (d < 0) return false;
+
+    if (src->type == OPERAND_IMMEDIATE) {
+        buffer_write(out, 0x81);
+        buffer_write(out, (uint8_t)(0xC0 | d));
+        uint32_t v = (uint32_t)src->value.imm;
+        buffer_write(out, (uint8_t)(v & 0xFF));
+        buffer_write(out, (uint8_t)((v >> 8) & 0xFF));
+        buffer_write(out, (uint8_t)((v >> 16) & 0xFF));
+        buffer_write(out, (uint8_t)((v >> 24) & 0xFF));
+        return true;
+    }
+    if (src->type == OPERAND_REGISTER) {
+        int s = x86_reg_code(src->value.reg);
+        if (s < 0) return false;
+        buffer_write(out, 0x01);
+        buffer_write(out, (uint8_t)(0xC0 | (s << 3) | d));
+        return true;
+    }
+    return false;
+}
